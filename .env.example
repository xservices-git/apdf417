# Copy to .env and adjust as needed
# Used by wrangler for local dev vars

# Cloudflare KV namespace id (see wrangler.toml)
APDF417_KV_ID=

# Default admin credentials (used on first boot / when KV empty)
ADMIN_USER=admin
ADMIN_PASS=changeme

# Public URL of the deployed worker (for CORS)
PUBLIC_URL=http://localhost:5173